// Prototype: GitHub Actions runners on Cloudflare Containers (strawgate/rgha#42).
// rgha calls this Worker over HTTPS (bearer token) to start, inspect and stop
// one container per runner. Deploy: `wrangler deploy`; set the token with
// `wrangler secret put RGHA_TOKEN`.
{
  "name": "rgha-runners",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "containers": [
    { "class_name": "RunnerLite", "image": "./Dockerfile.slim", "instance_type": "lite", "max_instances": 10 },
    { "class_name": "RunnerBasic", "image": "./Dockerfile", "instance_type": "basic", "max_instances": 10 },
    { "class_name": "RunnerStandard1", "image": "./Dockerfile", "instance_type": "standard-1", "max_instances": 10 },
    { "class_name": "RunnerStandard2", "image": "./Dockerfile", "instance_type": "standard-2", "max_instances": 4 },
    { "class_name": "RunnerStandard4", "image": "./Dockerfile", "instance_type": "standard-4", "max_instances": 4 }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RUNNER_LITE", "class_name": "RunnerLite" },
      { "name": "RUNNER_BASIC", "class_name": "RunnerBasic" },
      { "name": "RUNNER_STANDARD_1", "class_name": "RunnerStandard1" },
      { "name": "RUNNER_STANDARD_2", "class_name": "RunnerStandard2" },
      { "name": "RUNNER_STANDARD_4", "class_name": "RunnerStandard4" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Runner"] },
    { "tag": "v2", "new_sqlite_classes": ["RunnerBasic", "RunnerStandard1", "RunnerStandard2", "RunnerStandard4"], "deleted_classes": ["Runner"] },
    { "tag": "v3", "new_sqlite_classes": ["RunnerLite"] }
  ]
}
