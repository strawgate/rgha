#!/bin/bash
# rgha guest init for Firecracker microVMs (runs as PID 1).
#
# The kernel brings up eth0 from the `ip=` boot argument. The runner's
# single-use JIT config arrives on the second drive (/dev/vdb, raw, NUL
# padded) so it never appears on the kernel command line. The VM powers off
# when the runner exits; Firecracker then exits, which tells rgha the
# runner is done.

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mount -t cgroup2 cgroup2 /sys/fs/cgroup 2>/dev/null
hostname rgha
ip link set lo up 2>/dev/null

dns=$(sed -n 's/.*rgha.dns=\([^ ]*\).*/\1/p' /proc/cmdline)
echo "nameserver ${dns:-1.1.1.1}" > /etc/resolv.conf

echo "rgha-init: up after $(cut -d' ' -f1 /proc/uptime)s"
JIT=""
if [ -b /dev/vdb ]; then
  JIT=$(tr -d '\000' < /dev/vdb)
fi

# Optional hook run as root before the runner (e.g. starting dockerd).
if [ -x /etc/rgha/pre-runner ]; then
  /etc/rgha/pre-runner
fi

if [ -n "$JIT" ] && [ "$JIT" != "probe" ]; then
  cd /home/runner
  runuser -u runner -- env HOME=/home/runner ACTIONS_RUNNER_INPUT_JITCONFIG="$JIT" /home/runner/run.sh
  echo "rgha-init: runner exited $?"
else
  echo "rgha-init: probe mode"
  curl -s -o /dev/null -w "rgha-init: api.github.com %{http_code} in %{time_total}s\n" https://api.github.com
fi
sync
reboot -f
